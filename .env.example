# Copy this file to .env in the repository root.
# Frontend (Vite reads this file via envDir; only VITE_ variables reach the browser)
VITE_API_BASE_URL=http://localhost:8000

# Backend (set in the shell that runs backend/run.py; defaults shown)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional artifact overrides (relative to repo root); defaults shown
# CUSTOMER_DATA_PATH=backend/data/customer_data.parquet
# MODEL_PATH=models/repayx_model.joblib
# MODEL_METADATA_PATH=models/repayx_model.metadata.json
# TFIDF_VECTORIZER_PATH=backend/rag/tfidf_vectorizer.joblib
# TFIDF_MATRIX_PATH=backend/rag/customer_tfidf_matrix.npz
# TFIDF_IDS_PATH=backend/rag/customer_tfidf_ids.npy
# TFIDF_METADATA_PATH=backend/rag/tfidf_index.metadata.json
