# Copy this file to .env in the repository root. Never commit .env.
# Keep separate .env files (or secret stores) for sandbox/staging and production.
# Frontend (Vite reads this file via envDir; only VITE_ variables reach the browser)
VITE_API_BASE_URL=http://localhost:8000

# Backend (backend/run.py and backend/worker.py read root .env; shell variables take precedence)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional artifact overrides (relative to repo root); defaults shown
# CUSTOMER_DATA_PATH=backend/data/customer_data.parquet
# MODEL_PATH=models/repayx_model.joblib
# MODEL_METADATA_PATH=models/repayx_model.metadata.json
# TFIDF_VECTORIZER_PATH=backend/rag/tfidf_vectorizer.joblib
# TFIDF_MATRIX_PATH=backend/rag/customer_tfidf_matrix.npz
# TFIDF_IDS_PATH=backend/rag/customer_tfidf_ids.npy
# TFIDF_METADATA_PATH=backend/rag/tfidf_index.metadata.json

# =============================================================================
# EMI reminder automation (see docs/AUTOMATION.md)
# =============================================================================

# Database for customers, EMIs, reminder jobs and delivery logs. Shared by the API and worker.
# DATABASE_URL=sqlite:///backend/data/automation.sqlite3
AUTOMATION_DB_PATH=backend/data/automation.sqlite3

# sandbox = full pipeline, nothing sent externally. live = use the providers configured below.
AUTOMATION_MODE=sandbox
# In live mode, if set, ONLY these recipients (E.164 phones / emails) are messaged. Use for provider testing.
AUTOMATION_TEST_RECIPIENTS=

# Dashboard/API access: comma-separated name:role:key (roles: viewer, operator, admin; keys >= 24 chars).
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEYS=45NWy18e23em6LXwf56tCfjATZ-klXKUD_h2IPJZcO0

# Scheduling defaults (administrators can change policy later from the dashboard)
APP_TIMEZONE=Asia/Kolkata
DEFAULT_REMINDER_TIME=10:00
CONTACT_WINDOW_START=09:00
CONTACT_WINDOW_END=19:00
# How to read ambiguous dates like 05/10/2026 in CSVs: DMY (5 Oct) or MDY (10 May)
CSV_DATE_ORDER=DMY

# Worker and queue
SCHEDULER_POLL_SECONDS=15
SCHEDULER_BATCH_SIZE=25
SCHEDULER_LEASE_SECONDS=300
# true = run the worker inside the API process (local development only)
SCHEDULER_EMBEDDED=false
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
PROVIDER_RATE_PER_SECOND=5

# CSV import limits
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=50000

# Business details used in messages (left out of messages when blank; never invented)
COMPANY_NAME=RepayX
SUPPORT_PHONE=
SUPPORT_EMAIL=
PAYMENT_INSTRUCTIONS=
# e.g. https://pay.example.com/loans  -> link becomes https://pay.example.com/loans/<loan_id>
PAYMENT_LINK_BASE_URL=

# --- WhatsApp: Meta WhatsApp Business Platform (Cloud API) ---
# meta | baileys_bridge (unofficial, testing only) | none
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set the supported version shown in your Meta app's API Setup screen (default v21.0).
WHATSAPP_GRAPH_VERSION=
# Approved utility template with body variables {{1}} name, {{2}} amount, {{3}} due date, {{4}} loan id
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Webhook security: App Secret signs callbacks; verify token is your own random string.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:8005

# --- SMS: twilio | msg91 | none ---
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio posts delivery reports to, and the exact URL configured for inbound SMS
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=
# MSG91 (India, DLT): flow id of a DLT-approved template; variable names in template order
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_TEMPLATE_VARS=name,amount,due_date,loan_id
# Secret for the signed generic SMS webhook format (X-RepayX-Signature)
SMS_WEBHOOK_SECRET=

# --- Email: smtp | mailgun | none ---
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RepayX
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=

# --- Other webhooks ---
WEBHOOK_MAX_AGE_SECONDS=86400
PAYMENT_WEBHOOK_SECRET=

# --- Legacy WhatsApp Web page (backend/services/whatsapp_service.py) ---
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=true
# Generate separate random secrets; operator key must be at least 32 characters.
WHATSAPP_OPERATOR_KEY=
# WHATSAPP_CONTACTS_FILE=backend/data/whatsapp_contacts.json
# WHATSAPP_DB_PATH=backend/data/whatsapp.sqlite3
